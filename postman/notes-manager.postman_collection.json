    {
      "name": "Notes CRUD and search",
      "item": [
        {
          "name": "POST create note",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('noteId', pm.response.json().data.id);",
                  "pm.test('HTTP 201: POST create note', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"API practice plan\",\n  \"content\": \"Review CRUD and write a short report\",\n  \"categoryId\": {{categoryId}},\n  \"tagIds\": [{{tagId}}]\n}"
            },
            "url": "{{baseUrl}}/api/notes"
          }
        },
        {
          "name": "POST invalid note (expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('invalid note rejected', () => pm.response.to.have.status(400));",
                  "pm.test('HTTP 400: POST invalid note (expect 400)', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"\",\n  \"content\": \"\"\n}"
            },
            "url": "{{baseUrl}}/api/notes"
          }
        },
        {
          "name": "POST note with maximum title length",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('boundary title accepted', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('boundaryNoteId', pm.response.json().data.id);",
                  "pm.test('HTTP 201: POST note with maximum title length', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\",\n  \"content\": \"Boundary value test\"\n}"
            },
            "url": "{{baseUrl}}/api/notes"
          }
        },
        {
          "name": "GET notes",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/notes"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200: GET notes', () => pm.response.to.have.status(200));"
                ]
