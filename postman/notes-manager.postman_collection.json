{
  "info": {
    "name": "Notes Manager API",
    "description": "Sequential CRUD and validation requests for notes, categories and tags.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "tagId",
      "value": ""
    },
    {
      "key": "noteId",
      "value": ""
    },
    {
      "key": "boundaryNoteId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200: GET health', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Categories CRUD",
      "item": [
        {
          "name": "POST create category",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('categoryId', pm.response.json().data.id);",
                  "pm.test('HTTP 201: POST create category', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Study\",\n  \"description\": \"Study notes for API practice\"\n}"
            },
            "url": "{{baseUrl}}/api/categories"
          }
        },
        {
          "name": "GET categories",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/categories"
